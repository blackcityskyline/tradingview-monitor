{
  "name": "price-alert-daemon",
  "version": "1.0.0",
  "description": "Linux daemon for unlimited price alerts with system notifications and TradingView integration",
  "main": "dist/index.js",
  "bin": {
    "price-alert": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js start",
    "stop": "node dist/index.js stop",
